<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <!-- The reference Assembly-CSharp is publicized (private members made public). Unsafe mode
         marks this DLL unverifiable, which makes Mono skip access checks so those members work. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WoLGiantSpear</AssemblyName>
    <RootNamespace>WoLGiantSpear</RootNamespace>

    <!-- Folder holding the reference DLLs listed below (the repo's lib/ folder by default). -->
    <LibDir Condition="'$(LibDir)' == ''">$(MSBuildThisFileDirectory)..\lib</LibDir>
    <!-- Optional: set to your Wizard of Legend install to copy the build into BepInEx\plugins. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Wizard of Legend</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(LibDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(LibDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(LibDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LegendApi">
      <HintPath>$(LibDir)\LegendApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\giant_spear_icon.png" LogicalName="WoLGiantSpear.Assets.giant_spear_icon.png" />
    <EmbeddedResource Include="Assets\spear_thrust.png" LogicalName="WoLGiantSpear.Assets.spear_thrust.png" />
    <EmbeddedResource Include="Assets\giant_spear_throw.png" LogicalName="WoLGiantSpear.Assets.giant_spear_throw.png" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\WoLGiantSpear" />
  </Target>

</Project>
