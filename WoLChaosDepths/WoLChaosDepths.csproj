<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <!-- The reference Assembly-CSharp is publicized (private members made public). Unsafe mode
         marks this DLL unverifiable, which makes Mono skip access checks so those members work. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WoLChaosDepths</AssemblyName>
    <RootNamespace>WoLChaosDepths</RootNamespace>

    <!-- Folder holding the reference DLLs listed below (the repo's lib/ folder by default). -->
    <LibDir Condition="'$(LibDir)' == ''">$(MSBuildThisFileDirectory)..\lib</LibDir>
    <!-- Optional: set to your Wizard of Legend install to copy the build into BepInEx\plugins. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Wizard of Legend</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(LibDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(LibDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(LibDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(LibDir)\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(LibDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony (ships with BepInEx) for the signature unlock patch in SignatureUnlock.cs. -->
    <Reference Include="0Harmony">
      <HintPath>$(LibDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The items' artwork (Art/*.png), embedded; a PNG of the same name in an Art folder beside
         the DLL overrides it at runtime, so new art can be previewed without a rebuild. -->
    <EmbeddedResource Include="Art\*.png" LogicalName="WoLChaosDepths.Art.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\WoLChaosDepths" />
  </Target>

</Project>
