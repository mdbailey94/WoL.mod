<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <!-- The reference Assembly-CSharp is publicized (private members made public). Unsafe mode
         marks this DLL unverifiable, which makes Mono skip access checks so those members work. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WoLBuckler</AssemblyName>
    <RootNamespace>WoLBuckler</RootNamespace>

    <!-- Folder holding the reference DLLs listed below (the repo's lib/ folder by default). -->
    <LibDir Condition="'$(LibDir)' == ''">$(MSBuildThisFileDirectory)..\lib</LibDir>
    <!-- Optional: set to your Wizard of Legend install to copy the build into BepInEx\plugins. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Wizard of Legend</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(LibDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(LibDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(LibDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LegendApi">
      <HintPath>$(LibDir)\LegendApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\buckler_icon.png" LogicalName="WoLBuckler.Assets.buckler_icon.png" />
    <EmbeddedResource Include="Assets\buckler.png" LogicalName="WoLBuckler.Assets.buckler.png" />
    <EmbeddedResource Include="Assets\buckler_punch.png" LogicalName="WoLBuckler.Assets.buckler_punch.png" />
    <EmbeddedResource Include="Assets\buckler_held_8dir.png" LogicalName="WoLBuckler.Assets.buckler_held_8dir.png" />
    <EmbeddedResource Include="Assets\buckler_punch_8dir.png" LogicalName="WoLBuckler.Assets.buckler_punch_8dir.png" />
    <EmbeddedResource Include="Assets\buckler_held_left_8dir.png" LogicalName="WoLBuckler.Assets.buckler_held_left_8dir.png" />
    <EmbeddedResource Include="Assets\buckler_punch_left_8dir.png" LogicalName="WoLBuckler.Assets.buckler_punch_left_8dir.png" />
    <EmbeddedResource Include="Assets\buckler_disc_8dir.png" LogicalName="WoLBuckler.Assets.buckler_disc_8dir.png" />
    <EmbeddedResource Include="Assets\buckler_disc_big_8dir.png" LogicalName="WoLBuckler.Assets.buckler_disc_big_8dir.png" />
    <EmbeddedResource Include="Assets\buckler_held_8dir_enh.png" LogicalName="WoLBuckler.Assets.buckler_held_8dir_enh.png" />
    <EmbeddedResource Include="Assets\buckler_held_left_8dir_enh.png" LogicalName="WoLBuckler.Assets.buckler_held_left_8dir_enh.png" />
    <EmbeddedResource Include="Assets\buckler_punch_8dir_enh.png" LogicalName="WoLBuckler.Assets.buckler_punch_8dir_enh.png" />
    <EmbeddedResource Include="Assets\buckler_punch_left_8dir_enh.png" LogicalName="WoLBuckler.Assets.buckler_punch_left_8dir_enh.png" />
    <EmbeddedResource Include="Assets\buckler_disc.png" LogicalName="WoLBuckler.Assets.buckler_disc.png" />
    <EmbeddedResource Include="Assets\buckler_disc_big.png" LogicalName="WoLBuckler.Assets.buckler_disc_big.png" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\WoLBuckler" />
  </Target>

</Project>
