<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WoLMomentumSpear</AssemblyName>
    <RootNamespace>WoLMomentumSpear</RootNamespace>
    <LibDir Condition="'$(LibDir)' == ''">$(MSBuildThisFileDirectory)..\lib</LibDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Wizard of Legend</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp"><HintPath>$(LibDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(LibDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(LibDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LegendApi"><HintPath>$(LibDir)\LegendApi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LibDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\WoLMomentumSpear" />
  </Target>
</Project>
